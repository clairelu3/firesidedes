# Copy to .env.local (gitignored). Supabase → Project Settings → API.
VITE_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key

# The AI key is NOT here — it lives in Supabase → Edge Functions → Secrets:
#   OPENAI_API_KEY=sk-...   (Whisper transcription + memo tagging + chapter writing)

# Optional: the URL QR codes point to (e.g. your Vercel URL). Default: this laptop's Wi-Fi IP.
# VITE_PUBLIC_URL=https://dt-hackathon.vercel.app
