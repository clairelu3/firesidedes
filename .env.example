# Copy to .env.local (gitignored). Supabase → Project Settings → API.
VITE_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key

# AI keys are NOT here — they live in Supabase function secrets:
#   npx supabase secrets set ANTHROPIC_API_KEY=sk-ant-...
#   npx supabase secrets set OPENAI_API_KEY=sk-...   (optional, Whisper fallback)

# Optional: the URL QR codes point to (e.g. your Vercel URL). Default: this laptop's Wi-Fi IP.
# VITE_PUBLIC_URL=https://dt-hackathon.vercel.app
